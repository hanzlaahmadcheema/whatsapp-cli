[Unit]
Description=WhatsApp CLI System Tray Manager
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Note: When enabling via `wa autostart enable`, these paths are populated automatically.
# If installing manually, set WorkingDirectory to your repository clone directory.
WorkingDirectory=%h/whatsapp-cli
ExecStart=/usr/bin/python3 src/tray/manager.py
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
