{
  "name": "whatsapp-cli",
  "version": "1.0.0",
  "description": "Scriptable WhatsApp CLI, background daemon, 9-tool Model Context Protocol (MCP) server, and portable Agent Skill for AI assistants.",
  "main": "src/cli/index.js",
  "bin": {
    "wa": "bin/wa.js"
  },
  "scripts": {
    "wa": "node bin/wa.js",
    "daemon": "node src/daemon/index.js",
    "test": "node --test test/unit/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "fetch-web-build": "node scripts/fetch-web-build.js",
    "postinstall": "node scripts/wwebjs-patch.js",
    "patch": "node scripts/wwebjs-patch.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzlaahmadcheema/whatsapp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hanzlaahmadcheema/whatsapp-cli/issues"
  },
  "homepage": "https://github.com/hanzlaahmadcheema/whatsapp-cli#readme",
  "keywords": [
    "whatsapp",
    "cli",
    "daemon",
    "mcp",
    "model-context-protocol",
    "agent-skill",
    "ai-agents",
    "automation",
    "puppeteer"
  ],
  "author": "Hanzla Ahmad Cheema",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mime-types": "^3.0.2",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.7"
  }
}
